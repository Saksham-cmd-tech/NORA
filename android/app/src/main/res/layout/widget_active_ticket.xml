<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="2dp">

    <!-- 1. STACKVIEW FOR ACTIVE TICKET(S) - VERTICAL FLIP -->
    <StackView
        android:id="@+id/widget_stack_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:loopViews="true"
        android:visibility="visible" />

    <!-- ================= 2. NO TICKET / EMPTY LAYOUT ================= -->
    <LinearLayout
        android:id="@+id/layout_no_ticket"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_ticket_empty_bg"
        android:orientation="vertical"
        android:weightSum="100"
        android:visibility="gone">

        <!-- Top Ticket Body Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="70"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp">

            <!-- Header Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_notification_train"
                    android:tint="#FF4438"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NORA"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#FF4438" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WALLET"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="#8E8E98" />
            </LinearLayout>

            <!-- Centered Empty State Content -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/image_no_ticket"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_ticket_empty"
                    android:tint="#777785"
                    android:layout_marginBottom="3dp" />

                <TextView
                    android:id="@+id/text_no_ticket_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Active Train Ticket"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/text_no_ticket_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Bookings from IRCTC &amp; redRail appear here automatically"
                    android:textSize="9.5sp"
                    android:textColor="#8E8E98"
                    android:gravity="center"
                    android:maxLines="2" />
            </LinearLayout>
        </LinearLayout>

        <!-- Lower Stub Section for Empty State -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="30"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="2dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="+ TAP TO OPEN WALLET"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:textColor="#FF553E" />

            <ImageView
                android:layout_width="70dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_barcode_sample"
                android:tint="#5E5E6E" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
