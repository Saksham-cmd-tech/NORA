<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ticket_card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_ticket_bg"
    android:orientation="vertical"
    android:weightSum="100">

    <!-- Top Ticket Body Section (Dark Boarding Pass) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="70"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_train_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_notification_train"
                android:tint="#FF4438"
                android:layout_marginEnd="5dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NORA"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FF4438" />

            <FrameLayout
                android:layout_width="6dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/text_widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONFIRMED"
                android:textSize="8sp"
                android:textStyle="bold"
                android:textColor="#4ADE80"
                android:background="@drawable/widget_badge_bg"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:paddingTop="1.5dp"
                android:paddingBottom="1.5dp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/text_journey_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="28 OCT 2026"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#A0A0B2" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Train Banner Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_bg"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="1.5dp"
                android:paddingBottom="1.5dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:id="@+id/text_train_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="11039"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#FF553E" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_train_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Maharashtra Express"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Route & Timetable Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- From Station Block with Boarding Platform (Spot A) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_departure_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="11:20 PM"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/text_from_station"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PUNE · PF 5"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:textColor="#A0A0B2" />
            </LinearLayout>

            <!-- Arrow Route Connector -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#2E2E38" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="#FF4438"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#2E2E38" />
            </LinearLayout>

            <!-- To Station Block -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_arrival_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="08:15 PM"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/text_to_station"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="NGP"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:textColor="#A0A0B2" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Coach & Seat Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Coach Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_subtle_pill"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginEnd="5dp">

                <TextView
                    android:id="@+id/text_coach"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COACH B2"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:textColor="#FF553E" />
            </LinearLayout>

            <!-- Seat Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_subtle_pill"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:id="@+id/text_seat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SEAT 35"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_class_type"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="3A Class · Berth"
                android:textSize="9.5sp"
                android:textColor="#A0A0B2"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Lower Tear-Off Ticket Stub (Authentic Red/Orange with Full PNR) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="30"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="2dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/text_widget_pnr_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PNR REFERENCE · DIGITAL BOARDING PASS"
            android:textSize="7.5sp"
            android:textStyle="bold"
            android:textColor="#3D0C09"
            android:gravity="center" />

        <TextView
            android:id="@+id/text_widget_pnr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8492  019  482"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#0E0E10"
            android:gravity="center"
            android:layout_marginTop="1dp" />
    </LinearLayout>
</LinearLayout>
